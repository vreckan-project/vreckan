# Vreckan docker-compose configuration.
#
# Copy to `.env` and edit:   cp .env.example .env
#
# The variables referenced as ${VAR} in docker-compose.yml are read from here;
# the sections below also list every other VRECKAN_* setting the server (and
# the bundled scripts) understand, for easy reference. Anything left at its
# default is fine for a local / single-host setup.
#
# Precedence: a value stored in the config database (edited on the admin SSO /
# Certificates pages) overrides the environment, which overrides the code
# default. Only the OIDC and ACME sections are editable from the admin UI.

# --- Commonly used -----------------------------------------------------------
# Port the server binds with TLS (API + session proxy + web client on one
# listener). The entrypoint reads this directly and defaults to 443 when unset.
VRECKAN_API_PORT=443
# Host port the published mapping is bound to in docker-compose.yml
# (the "${VRECKAN_HOST_PORT:-443}:${VRECKAN_API_PORT:-443}" line).
VRECKAN_HOST_PORT=443
# GID of the host group that owns /var/run/docker.sock
# Find it by running the following:
# getent group docker | cut -d: -f3
VRECKAN_DOCKER_GROUP=973
# Host path for /data volume host path
VRECKAN_DATA_PATH=./vreckan-data


# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. RUST_LOG, when set, takes precedence.
VRECKAN_LOG_LEVEL=INFO

# --- Database (default: the bundled Postgres service) -------------------------
# docker-compose defaults to the Postgres service in this file. Override any of
# these to point at your own database, or set VRECKAN_DATABASE_URL to a full
# URL (sqlite:///path or postgres://user:pass@host:5432/db) to bypass the
# service entirely.
#
# The bundled service runs with the default credentials vreckan/vreckan.
# Set VRECKAN_DB_PASS (and ideally VRECKAN_DB_USER) to your own values before
# you expose the service beyond the host; VRECKAN_DB_PASS feeds both the
# VRECKAN_DATABASE_URL default above and the service's POSTGRES_PASSWORD.
#
#VRECKAN_DATABASE_URL=postgres://vreckan:vreckan@postgres:5432/vreckan
# Backend: sqlite (bare-binary default) | postgres (compose default) | mysql
# (MariaDB also accepted).
#VRECKAN_DB_BACKEND=postgres
# Database host (postgres/mysql).
#VRECKAN_DB_HOST=postgres
# Database port; 0 means the backend default (5432 postgres, 3306 mysql).
#VRECKAN_DB_PORT=0
#VRECKAN_DB_USER=vreckan
#VRECKAN_DB_PASS=vreckan
#VRECKAN_DB_NAME=vreckan
# SQLite database file path (sqlite backend only). Defaults to
# {data_root}/vreckan.db.
#VRECKAN_DB_PATH=/data/vreckan.db
#
# Host port the bundled Postgres is published on. Defaults to loopback only
# (127.0.0.1:5432) so it is not reachable from other hosts on your network;
# the server reaches it over the internal compose network either way. Set to
# `5432` to publish on every interface, or comment out the `ports` entry in
# docker-compose.yml to disable host publication entirely.
#VRECKAN_POSTGRES_PORT=127.0.0.1:5432

# --- Storage & paths ---------------------------------------------------------
# All persistent data lives under the data root (default /data — the
# vreckan-data bind mount). Don't change these unless you change them ALL.
#VRECKAN_DATA_ROOT=/data
#VRECKAN_STORAGE_PATH=/data/storage
#VRECKAN_UPLOAD_DIR=/data/storage/vreckan_uploads
#VRECKAN_APP_ICONS_PATH=/data/storage/vreckan_app_icons
#VRECKAN_HOME_TEMPLATES_PATH=/data/storage/vreckan_home_templates
#VRECKAN_PUBLIC_STORAGE_PATH=/data/storage/vreckan_public
# Mount point for home directories inside the app containers.
#VRECKAN_CONTAINER_CONFIG_PATH=/config
#VRECKAN_AUTOSTART_CACHE_PATH=/data/autostart_cache
#VRECKAN_APP_STORE_CACHE_PATH=/data/app_stores_cache
#VRECKAN_BACKUPS_PATH=/data/backups
# How many of the newest config-DB backup archives the server keeps (0 keeps
# all); archives are written 0600. The backup-postgres.sh script reads the same
# variable name with its own 14 fallback (see the "Postgres backup script"
# section below).
#VRECKAN_BACKUP_RETENTION=7
# Default UID/GID to run app containers as (same as the server's non-root user,
# so server- and container-owned files under /data share ownership).
#VRECKAN_PUID=1000
#VRECKAN_PGID=1000

# --- Optional: App catalog -------------------------------------------------------------
# URL for the YAML file defining default available applications.
#VRECKAN_APP_RESOURCE_PATH=https://raw.githubusercontent.com/linuxserver/sealskin-apps/refs/heads/master/apps.yml
# Path to the directory for default application templates.
#VRECKAN_DEFAULT_APP_TEMPLATES_PATH=server/default_templates
# Path to the bundled template-schema YAML (the image baseline for the template
# editor).
#VRECKAN_TEMPLATE_SCHEMA_PATH=server/template_schema.yml
# Enable automatic pulling of the latest app images in the background.
#VRECKAN_AUTO_UPDATE_APPS=true
# How often to check for app image updates (in seconds).
#VRECKAN_AUTO_UPDATE_INTERVAL_SECONDS=3600

# --- Optional: Authentication & sessions -----------------------------------------------
#VRECKAN_SESSION_COOKIE_NAME=vreckan_session_token
#VRECKAN_AUTH_COOKIE_NAME=vreckan_auth
# Lifetime (in seconds) of a server-issued web authentication token/cookie.
#VRECKAN_AUTH_TOKEN_TTL_SECONDS=28800
# How often to run the cleanup job for expired shares (in seconds).
#VRECKAN_SHARE_CLEANUP_INTERVAL_SECONDS=600
# Server E2EE RSA key location; written 0600. Defaults to the persistent data
# root so the key survives container recreation (ANT-45 P2-1).
#VRECKAN_SERVER_PRIVATE_KEY_PATH=/data/ssl/server_key.pem
#
# Bootstrap admin account seeded on first run (when no admin exists yet); the
# account is marked must-change-password until the first change.
#VRECKAN_BOOTSTRAP_ADMIN_USERNAME=admin
#VRECKAN_BOOTSTRAP_ADMIN_PASSWORD=admin1234
#
# While the bootstrap admin account is still marked must-change-password,
# how to treat a login with the literal default password admin1234:
# allow | warn (default) | reject
#VRECKAN_DEFAULT_PASSWORD_POLICY=warn
#
# Brute-force limiter on /api/auth/login: failed logins per (client IP,
# username) pair within the window before a temporary lockout (HTTP 429,
# logged at warn). 0 disables the limiter.
#VRECKAN_LOGIN_MAX_ATTEMPTS=5
#VRECKAN_LOGIN_LOCKOUT_SECONDS=900
#
# Reverse proxies allowed to sit in front of the server (comma-separated
# IPs/CIDRs). Only when the direct TCP peer matches this list are forwarded
# headers honoured: the leftmost X-Forwarded-For entry for the login limiter
# above, and X-Forwarded-Proto for the session cookie's Secure flag and the
# OIDC redirect URL. Empty (default) trusts no proxy, so the scheme is always
# the real https connection — right for a directly-exposed origin. Set it when
# a proxy fronts the server; otherwise the login limiter keys on the proxy's
# address and sees every client as one source. Environment-only: there is
# no admin-UI or admin-settings API field for it (docs/ops.md §5).
#VRECKAN_TRUSTED_PROXIES=10.0.0.0/8, 192.168.1.5

# --- Optional: OIDC / SSO ------------------------------------------------------
# Uncomment and fill in to enable single sign-on (e.g. authentik, Keycloak,
# Entra ID). When enabled, users authenticate via the provider and are
# auto-provisioned on first login. These can also be edited from the admin UI's
# SSO page (a value set there overrides the environment).
#
#VRECKAN_OIDC_ENABLED=false
#VRECKAN_OIDC_ISSUER=https://auth.example.com/application/o/vreckan/
#VRECKAN_OIDC_CLIENT_ID=your-client-id
#VRECKAN_OIDC_CLIENT_SECRET=your-client-secret
#VRECKAN_OIDC_REDIRECT_URI=https://ss.example.com/api/auth/oidc/callback
# Space-separated OIDC scopes requested from the provider.
#VRECKAN_OIDC_SCOPES=openid email profile
#VRECKAN_OIDC_ALLOW_SIGNUP=true
# Lifetime of a single OIDC authorize state token (seconds).
#VRECKAN_OIDC_STATE_TTL_SECONDS=600
# Comma/space-separated group names; OIDC users in any of these groups are
# auto-promoted to admin.
#VRECKAN_OIDC_ADMIN_GROUPS=vdi-admins
# Comma/space-separated group names that map to regular (non-admin) Vreckan
# groups; an SSO user not in an admin group is assigned to their first group in
# this list.
#VRECKAN_OIDC_USER_GROUPS=
# Require a verified id_token signature; fail closed when the JWKS is
# unreachable (set false for a claims-only fallback).
#VRECKAN_OIDC_REQUIRE_SIGNATURE=true

# --- Optional: ACME certificates (native acmex client) -----------------------
# Issue and renew real TLS certificates with the built-in ACME client instead
# of the default self-signed certificate (ANT-128). All of these can also be
# set from the admin UI's Certificates page (a value set there overrides the
# environment).
#
#VRECKAN_ACME_ENABLED=false
# Certificate authority: letsencrypt (default) | zerossl | google | a full
# custom ACME directory URL. Only letsencrypt honours VRECKAN_ACME_STAGING.
#VRECKAN_ACME_CA=letsencrypt
# Allow a plaintext http:// custom ACME directory URL (VRECKAN_ACME_CA). Off by
# default: https is required so the account-key JWSes and CA responses stay
# encrypted in transit (ANT-275).
#VRECKAN_ACME_ALLOW_HTTP_CA=false
# Comma-separated domain(s) to issue certificates for.
#VRECKAN_ACME_DOMAINS=example.com,www.example.com
# Auth method: dns-cloudflare (Cloudflare DNS-01, works behind a reverse proxy)
# or http-01 (the ACME server fetches from your domain over HTTP).
#VRECKAN_ACME_AUTH=dns-cloudflare
# Cloudflare DNS-01 credentials (only used when VRECKAN_ACME_AUTH=dns-cloudflare).
#VRECKAN_ACME_CLOUDFLARE_EMAIL=you@example.com
#VRECKAN_ACME_CLOUDFLARE_TOKEN=your-cloudflare-api-token
# Use the Let's Encrypt staging server (test certs, no production rate limits).
#VRECKAN_ACME_STAGING=false
# Automatically renew in the background.
#VRECKAN_ACME_AUTO_RENEW=true
# How often to check for renewal (hours) and how close to expiry to renew (days).
#VRECKAN_ACME_RENEW_CHECK_HOURS=6
#VRECKAN_ACME_RENEW_BEFORE_DAYS=30
# DNS-01 provider used when auth is not http-01: cloudflare (default),
# route53, digitalocean, linode, azure, google, alibaba, godaddy, tencent,
# huawei, cloudns.
#VRECKAN_ACME_DNS_PROVIDER=cloudflare
# Cloudflare zone ID (blank: auto-discovered from the API token).
#VRECKAN_ACME_CLOUDFLARE_ZONE_ID=
# JSON credentials for non-Cloudflare DNS providers
# (e.g. {"hosted_zone_id":"Z..."} for route53).
#VRECKAN_ACME_DNS_PROVIDER_CONFIG=

# --- Optional: Postgres backup script (scripts/backup-postgres.sh) --------
# Read by the script, not by docker compose. When running the script on the
# host (e.g. from cron), source this .env first (docs/ops.md §4.2). The script
# also reads VRECKAN_BACKUP_RETENTION, but independently of the server setting
# (same variable name, different consumer): its own fallback is 14, while the
# server setting's fallback is 7. Setting it once in this file applies to both.
#VRECKAN_BACKUP_DIR=./vreckan-data/backups
#VRECKAN_POSTGRES_CONTAINER=vreckan-postgres

# --- Optional: SQLite → Postgres cutover scripts ----------------------------
# Read by scripts/migrate-sqlite-to-postgres.py, scripts/snapshot-sqlite.py and
# scripts/verify-cutover.py (docs/ops.md §4.1, docs/cutover.md). Not read by the
# server or docker compose.
# Path to the existing SQLite database file.
#VRECKAN_SQLITE_PATH=/data/vreckan.db
# Postgres DSN for the cutover target (falls back to VRECKAN_DATABASE_URL).
#VRECKAN_POSTGRES_DSN=postgres://vreckan:vreckan@postgres:5432/vreckan

# --- Optional: testing -------------------------------------------------------
# Directory (visible to the Docker daemon) used as the throwaway data root for
# the docker-dependent test suite (docs/ops.md §3.2).
#VRECKAN_TEST_TMPDIR=/tmp/vreckan-tests
