# Keep the Docker build context lean. The image only needs the Cargo
# manifests, src/, crates/, and server/ (web client + template schema).
# Persistent state is provided at runtime by Docker volumes / bind mounts,
# not baked into the image.
#
# NOTE (ANT-1312): this file is a union serving BOTH root Dockerfiles —
# the vreckan-app `Dockerfile` and the platform `docker/Dockerfile.platform-base`
# (both build with the repo root as context). The platform section below must
# stay LAST: dockerignore is last-match-wins, and the platform build's
# `!...` re-include lines (runner drift-check inputs) must override the
# global vreckan exclusions (`*.md`, `docs/`) above them.
.git/
.gitignore
.env
# Previous build outputs must never leak into the context.
target/
# Python-era leftovers that may still be present in the tree.
__pycache__/
**/__pycache__/
*.pyc
*.pyo
# Tests are only pulled in by the `test` stage below (CI runs `cargo test`
# inside that image); the build and runtime stages never COPY them, so the
# prod image stays test-free.
tests/
!tests/
# Docs and site — not needed to build or run the server.
*.md
site/
docs/
screenshots/
shots/
data/
vreckan-data/
vreckan-postgres-data/
.pytest_cache/
# Security-scan output (trivy/grype JSON reports + the parse helper) — kept
# out of the image. Safe to delete; regenerate with the Task 8 scan commands.
_scan_out/
*.log
val_out.txt
codeto*
# CI plumbing (Gitea mirror/trigger) is not needed in the image.
.github/
# (the bare `scripts/` exclusion from the vreckan-only era was dropped in
# ANT-1312: the platform Dockerfile COPYs scripts/docker-entrypoint.sh and
# scripts/link-plugin-dev-sdk.mjs from the root scripts/ dir.)

# --- Platform (v2026.1117.0 base lineage) entries ---
.paperclip
.pnpm-store
node_modules
**/node_modules
coverage
tmp
packages/paperclip-runner/dist
packages/paperclip-runner/runner/target
packages/paperclip-runner/devtools
packages/paperclip-runner/docs
packages/paperclip-runner/examples
packages/paperclip-runner/test
packages/paperclip-runner/test-fixtures
packages/paperclip-runner/test-support
packages/paperclip-runner/**/*.md
packages/paperclip-runner/**/*.spec.ts
packages/paperclip-runner/**/*.spec.tsx
packages/paperclip-runner/**/*.test.cjs
packages/paperclip-runner/**/*.test.cts
packages/paperclip-runner/**/*.test.js
packages/paperclip-runner/**/*.test.jsx
packages/paperclip-runner/**/*.test.mjs
packages/paperclip-runner/**/*.test.mts
packages/paperclip-runner/**/*.test.ts
packages/paperclip-runner/**/*.test.tsx
packages/paperclip-runner/runner/crates/*/tests
packages/paperclip-runner/scripts/*-smoke.mjs
# The provider-pack builder imports this helper during image builds.
!packages/paperclip-runner/scripts/kimi-provider-pack-smoke.mjs
# Exceptions (last match wins): the image build re-runs the runner's
# generated-file drift checks, so their committed outputs and inputs must
# survive the slimming above. 2026-09-04: the *.md rule stripped the
# committed capability contract out of the context and every image build
# on master failed its drift check — .github/docker-context-checks.Dockerfile
# now guards this in PR CI.
!packages/paperclip-runner/generated/**
!packages/paperclip-runner/docs/capability-contract.md
# check:runner-workflow-traceability access()es every regression test the
# stress-traceability spec names — those are src/**/*.test.ts files, so
# they must survive the *.test.ts rule above.
!packages/paperclip-runner/src/**/*.test.ts
!packages/paperclip-runner/src/**/*.test.tsx

packages/grok-acp/bin

# Images build their pinned Copilot assets instead of copying host binaries.
/packages/paperclip-runner/provider-assets/
/server/provider-assets/

!packages/paperclip-runner/test/fixtures/kimi-profile-v*-identity.json

!packages/paperclip-runner/test/fixtures/grok-profile-v*-identity.json

!packages/paperclip-runner/test/fixtures/copilot-profile-v*-identity.json

!packages/paperclip-runner/test-fixtures/pi-acp/profile-v34-identity.json
