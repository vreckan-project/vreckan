# Keep the Docker build context lean. The image only needs the Cargo
# manifests, src/, and server/ (web client + template schema).
# Persistent state is provided at runtime by Docker volumes / bind mounts,
# not baked into the image.
.git/
.gitignore
.env
# Previous build outputs must never leak into the context.
target/
# Python-era leftovers that may still be present in the tree.
__pycache__/
**/__pycache__/
*.pyc
*.pyo
# Tests are only pulled in by the `test` stage below (CI runs `cargo test`
# inside that image); the build and runtime stages never COPY them, so the
# prod image stays test-free.
tests/
!tests/
# Docs and site — not needed to build or run the server.
*.md
site/
docs/
screenshots/
shots/
data/
vreckan-data/
vreckan-postgres-data/
.pytest_cache/
# Security-scan output (trivy/grype JSON reports + the parse helper) — kept
# out of the image. Safe to delete; regenerate with the Task 8 scan commands.
_scan_out/
*.log
val_out.txt
codeto*
# CI plumbing (Gitea mirror/trigger) is not needed in the image.
.github/
scripts/
