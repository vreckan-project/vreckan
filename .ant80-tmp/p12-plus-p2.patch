+#[tokio::test]
+async fn test_e2ee_key_existing_file_tightened_to_0600() {
+    let _root = TempDir::new();
+    let mut s = common::test_settings(_root.path());
+    // Pre-create the key at loose (0644) permissions, as an older version
+    // would have left it.
+    let key = rsa::RsaPrivateKey::new(&mut rand_core::OsRng, 2048).unwrap();
+    let pem = key.to_pkcs8_pem(pkcs8::LineEnding::LF).unwrap().to_string();
+    let parent = std::path::Path::new(&s.server_private_key_path)
+        .parent()
+        .unwrap();
+    std::fs::create_dir_all(parent).unwrap();
+    std::fs::write(&s.server_private_key_path, &pem).unwrap();
+    std::fs::set_permissions(
+        &s.server_private_key_path,
+        std::os::unix::fs::PermissionsExt::from_mode(0o644),
+    )
+    .unwrap();
+    vreckan::e2ee::init_server_key(&s).unwrap();
+    let mode = std::fs::metadata(&s.server_private_key_path)
+        .unwrap()
+        .permissions()
+        .mode()
+        & 0o777;
+    assert_eq!(mode, 0o600);
+}
